
{% extends 'base.html.twig' %}

{% block title %}Блог — Сайт по ремонту авто{% endblock %}

{% block description %}
    <meta name="description" content="Полезные статьи, советы и рекомендации по ремонту и обслуживанию автомобилей.">
{% endblock %}

{% block header %}
    {{ include('elements/header/header.html.twig') }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/blog.css') }}">
{% endblock %}

{% block body %}

    <section class="blog-page">
        <div class="container">

            <div class="blog-heading">
                <span class="blog-subtitle">Полезная информация</span>
                <h1>Наш блог</h1>
                <p>Советы по ремонту, обслуживанию и эксплуатации автомобилей.</p>
            </div>

            {% if posts is not empty %}

                <div class="blog-grid">

                    {% for post in posts %}
                        <article class="blog-card">

                            <a href="{{ path('blog_show', {slug: post.slug}) }}"
                               class="blog-card-image">

                                {% if post.image %}
                                    <img src="{{ asset('uploads/blog/' ~ post.image) }}"
                                         alt="{{ post.title }}">
                                {% else %}
                                    <div class="blog-no-image">
                                        <span>Статья</span>
                                    </div>
                                {% endif %}

                            </a>

                            <div class="blog-card-content">

                                {% if post.publishedAt %}
                                    <time class="blog-date">
                                        {{ post.publishedAt|date('d.m.Y') }}
                                    </time>
                                {% endif %}

                                <h2>
                                    <a href="{{ path('blog_show', {slug: post.slug}) }}">
                                        {{ post.title }}
                                    </a>
                                </h2>

                                {% if post.excerpt %}
                                    <p>
                                        {{ post.excerpt|length > 150
                                        ? post.excerpt|slice(0, 150)|trim ~ '...'
                                        : post.excerpt
                                        }}
                                    </p>
                                {% endif %}

                                <a href="{{ path('blog_show', {slug: post.slug}) }}"
                                   class="blog-read-more">
                                    Читать статью →
                                </a>

                            </div>
                        </article>
                    {% endfor %}

                </div>

            {% else %}

                <div class="blog-empty">
                    <h2>Скоро здесь появятся статьи</h2>
                    <p>Мы готовим для вас полезные материалы.</p>
                </div>

            {% endif %}

        </div>
    </section>

{% endblock %}

{% block footer %}
    {{ include('elements/footer/footer.html.twig') }}
{% endblock %}
